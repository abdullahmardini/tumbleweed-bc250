#!/usr/bin/bash
# Route GPU waves to all 40 CUs of the AMD BC-250 through umr.
#
# Register values are from duggasco's A/B tests:
# https://github.com/duggasco/bc250-40cu-unlock/blob/main/docs/technical-report.md
# Writes go through amdgpu debugfs MMIO, not the SMU mailbox, so they do not
# contend with the governor. They are volatile: a cold boot restores stock.
set -euo pipefail

readonly GPU_DEVICE_ID=0x13fe
readonly DEBUGFS_DRI=/sys/kernel/debug/dri
readonly DRI_WAIT_SECONDS=30

# Two shader engines with two shader arrays each, five WGPs per array.
readonly SHADER_ENGINES=(0 1)
readonly SHADER_ARRAYS=(0 1)

readonly REG_CC='*.*.mmCC_GC_SHADER_ARRAY_CONFIG'
readonly REG_SPI='*.*.mmSPI_PG_ENABLE_STATIC_WGP_MASK'
readonly REG_RLC='*.*.mmRLC_PG_ALWAYS_ON_WGP_MASK'

# Factory harvest: WGP 3-4 of every array fused off, WGP 0-2 dispatched.
readonly CC_STOCK=0xfff80000
readonly CC_UNLOCKED=0xffe00000
readonly SPI_STOCK=0x00000007
readonly WGP_ALL=0x0000001f

die() { echo "bc250-40cu: $*" >&2; exit 1; }

# umr prints "<regpath> => 0x...": keep the last hex word.
read_reg() {
    local reg=$1 se=$2 sh=$3 out value
    out=$(umr -b "$se" "$sh" x -r "$reg" 2>&1) || die "umr read $reg SE$se SH$sh failed: $out"
    value=$(grep -oE '0x[0-9a-fA-F]+' <<<"$out" | tail -n 1)
    [[ -n $value ]] || die "no value from umr read $reg SE$se SH$sh: $out"
    printf '0x%08x\n' "$((value))"
}

write_reg() {
    local reg=$1 value=$2 se=$3 sh=$4 out
    out=$(umr -b "$se" "$sh" x -w "$reg" "$value" 2>&1) || die "umr write $reg SE$se SH$sh failed: $out"
    # umr exits 0 on some lookup errors, so check its output too.
    if grep -qiE 'error|unknown|invalid' <<<"$out"; then
        die "umr write $reg SE$se SH$sh failed: $out"
    fi
}

require_bc250() {
    local dev
    for dev in /sys/bus/pci/devices/*; do
        [[ $(<"$dev/vendor") == 0x1002 && $(<"$dev/device") == "$GPU_DEVICE_ID" ]] && return 0
    done
    die "no BC-250 GPU (1002:${GPU_DEVICE_ID#0x}) found"
}

# amdgpu may still be probing when the unit starts.
wait_for_debugfs() {
    local waited=0
    until compgen -G "$DEBUGFS_DRI/*/amdgpu_regs" >/dev/null; do
        (( waited++ < DRI_WAIT_SECONDS )) || die "no amdgpu debugfs under $DEBUGFS_DRI"
        sleep 1
    done
}

cmd_status() {
    local se sh cc spi
    for se in "${SHADER_ENGINES[@]}"; do
        for sh in "${SHADER_ARRAYS[@]}"; do
            cc=$(read_reg "$REG_CC" "$se" "$sh")
            spi=$(read_reg "$REG_SPI" "$se" "$sh")
            echo "SE$se SH$sh: CC=$cc SPI=$spi"
        done
    done
}

cmd_apply() {
    local se sh cc spi pending=0
    for se in "${SHADER_ENGINES[@]}"; do
        for sh in "${SHADER_ARRAYS[@]}"; do
            cc=$(read_reg "$REG_CC" "$se" "$sh")
            spi=$(read_reg "$REG_SPI" "$se" "$sh")
            if [[ $cc == "$CC_UNLOCKED" && $spi == "$WGP_ALL" ]]; then
                continue
            fi
            # Any other layout is a harvest we have no test data for.
            [[ $cc == "$CC_STOCK" && $spi == "$SPI_STOCK" ]] ||
                die "SE$se SH$sh reads CC=$cc SPI=$spi, expected stock $CC_STOCK/$SPI_STOCK; not touching it"
            pending=1
        done
    done
    if (( ! pending )); then
        echo "already unlocked"
        return 0
    fi

    for se in "${SHADER_ENGINES[@]}"; do
        for sh in "${SHADER_ARRAYS[@]}"; do
            write_reg "$REG_CC" "$CC_UNLOCKED" "$se" "$sh"
            write_reg "$REG_SPI" "$WGP_ALL" "$se" "$sh"
        done
    done
    write_reg "$REG_RLC" "$WGP_ALL" x x
    cmd_status
}

[[ $(id -u) -eq 0 ]] || die "must run as root (umr needs debugfs)"
command -v umr >/dev/null || die "umr not installed"
require_bc250
wait_for_debugfs

case "${1:-}" in
    status) cmd_status ;;
    apply) cmd_apply ;;
    *) echo "usage: bc250-40cu {status|apply}" >&2; exit 2 ;;
esac
